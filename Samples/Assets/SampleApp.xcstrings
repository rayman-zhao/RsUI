    "Item views are rebuilt when containers are realized (virtualization included); return fresh views and never cache old elements." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item views are rebuilt when containers are realized (virtualization included); return fresh views and never cache old elements."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目视图在容器就绪时重建（含虚拟化回收复用）；闭包应返回新视图、不要缓存旧元素。"
          }
        }
      }
    },
    "itemsSource is one internal observable vector callers never touch: its elements are the id strings in the id flavor, or write-only index numbers in the index flavor (count, order and change notification only)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "itemsSource is one internal observable vector callers never touch: its elements are the id strings in the id flavor, or write-only index numbers in the index flavor (count, order and change notification only)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "itemsSource 是内部单一可观察向量、调用方不触碰：id 味的元素即 id 字符串，索引味的元素是只写不读的索引数字（仅承载计数、顺序与变更通知）。"
          }
        }
      }
