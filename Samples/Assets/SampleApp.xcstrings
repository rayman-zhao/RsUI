          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the id flavor when items have an identity that must survive insert/remove (model keys, URLs): content derives from the id and stays put while indexes shift."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目有必须扛过插入/移除的身份（模型主键、URL）时选 id 味：内容由 id 派生，顺移后原地不动。"
          }
        }
      }
    },
    "Pick the index flavor when data is naturally positional (array rows, snapshot pages): no id bookkeeping, no stringify/parse round-trips, zero unboxing dependencies." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the index flavor when data is naturally positional (array rows, snapshot pages): no id bookkeeping, no stringify/parse round-trips, zero unboxing dependencies."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据天然按位置组织（数组行、快照页）时选索引味：没有 id 簿记、没有字符串与整数间的转换往返、零解箱依赖。"
          }
        }
      }
    },
