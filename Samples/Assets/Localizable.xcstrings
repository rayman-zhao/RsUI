      }
    },
    "Window / Level (CT)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Window / Level (CT)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗宽 / 窗位（CT）"
          }
        }
      }
    },
    "Medical imaging maps the selected HU range to grayscale: Window Width = upper − lower, Window Level = (upper + lower) / 2. The bar previews the mapping." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medical imaging maps the selected HU range to grayscale: Window Width = upper − lower, Window Level = (upper + lower) / 2. The bar previews the mapping."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医学影像把选中的 HU 区间映射为灰阶：窗宽 = 上限 − 下限，窗位 = (上限 + 下限) / 2。色带实时预览该映射。"
          }
        }
      }
    },
    "Window Width (WW)" : {
      "extractionState" : "manual",
      "localizations" : {
