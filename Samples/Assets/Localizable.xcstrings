    "Layout stays the native ItemsView property; the default style is already a single-column StackLayout — set your own for spacing or grids." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout stays the native ItemsView property; the default style is already a single-column StackLayout — set your own for spacing or grids."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局沿用 ItemsView 原生属性，默认样式即单列 StackLayout；需要间距或网格布局时自行设置即可。"
          }
        }
      }
    },
    "The list needs a parent of finite height (e.g. a star Grid row) to scroll inside; an infinite StackPanel breaks scrolling." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list needs a parent of finite height (e.g. a star Grid row) to scroll inside; an infinite StackPanel breaks scrolling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表需要有限高度的父容器（如 Grid 星型行）才能内部滚动；放进无限高的 StackPanel 会导致内部滚动失效。"
          }
        }
      }
    },
    "Code-built itemTemplate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code-built itemTemplate"
