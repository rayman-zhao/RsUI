          }
        }
      }
    },
    "The readout shows the current lower – upper values." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The readout shows the current lower – upper values."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右侧文本实时显示当前下限 – 上限。"
          }
        }
      }
    },
    "Window / Level (CT)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Window / Level (CT)"
