    },
    "Reset" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置"
          }
        }
      }
    },
    "Item views are rebuilt by id when containers are realized (virtualization included); return fresh views and never cache old elements." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item views are rebuilt by id when containers are realized (virtualization included); return fresh views and never cache old elements."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目视图在容器就绪（含虚拟化回收复用）时按 id 重建；闭包应返回全新视图、不要缓存复用旧元素。"
          }
        }
      }
    },
    "itemsSource is driven by one internal observable vector whose elements are the id strings (count, order and virtualization only); callers never touch it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "itemsSource is driven by one internal observable vector whose elements are the id strings (count, order and virtualization only); callers never touch it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "itemsSource 由内部单个可观察向量驱动（元素即 id 字符串，仅决定数量、顺序与虚拟化），调用方无需接触。"
          }
        }
      }
    },
    "The internal itemsSource is a single observable vector created by the typed factory single_threaded_observable_vector (C++ shim underneath; the projection has no such factory); in-place mutations fire native VectorChanged, which drives the repeater's incremental realization." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The internal itemsSource is a single observable vector created by the typed factory single_threaded_observable_vector (C++ shim underneath; the projection has no such factory); in-place mutations fire native VectorChanged, which drives the repeater's incremental realization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部 itemsSource 是经类型化工厂 single_threaded_observable_vector 创建的单个可观察向量（底层为 C++ shim，投影层没有这个工厂）；原地增删会发出原生 VectorChanged，驱动 repeater 增量实现化。"
          }
        }
      }
    },
