    "Why ItemsView" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why ItemsView"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么需要 ItemsView"
          }
        }
      }
    },
    "ItemsView wraps that pattern: callers provide a string id list and a build closure; item content is derived from the id, so it stays stable while indexes shift on insert/remove." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ItemsView wraps that pattern: callers provide a string id list and a build closure; item content is derived from the id, so it stays stable while indexes shift on insert/remove."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ItemsView 封装了这一模式：调用方提供字符串 id 列表与构建闭包；条目内容从 id 派生，插入/移除导致索引顺移时内容保持稳定。"
          }
        }
      }
    },
    "init(makeIdView:) — the only initializer parameter (view build closure, keyed by string id)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "init(makeIdView:) — the only initializer parameter (view build closure, keyed by string id)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "init(makeIdView:) — 唯一的初始化参数（视图构建闭包，以字符串 id 为键）。"
          }
        }
      }
    },
    "setIds(_:) — full reset with a new id list (selection and scroll position reset)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "setIds(_:) — full reset with a new id list (selection and scroll position reset)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "setIds(_:) — 用新 id 列表整体重置（选择与滚动位置重置）。"
          }
        }
      }
    },
    "A reusable list built over ItemsView, driven by string item ids. Item views are built by a Swift closure from the id, so content stays stable while indexes shift. Add, insert and remove items incrementally — realized items, selection and scroll position are preserved; Reset goes through setIds and rebuilds the whole list." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reusable list built over ItemsView, driven by string item ids. Item views are built by a Swift closure from the id, so content stays stable while indexes shift. Add, insert and remove items incrementally — realized items, selection and scroll position are preserved; Reset goes through setIds and rebuilds the whole list."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 ItemsView 的可复用列表组件，以字符串 id 驱动。条目视图由 Swift 闭包按 id 构建，索引顺移时内容保持稳定。增删条目均为增量更新——已实现条目、选择与滚动位置保留；“重置”走 setIds 整体重建列表。"
          }
        }
      }
    },
    "appendIds(_:) / insertIds(_:at:) / removeIds(_:) / removeIndexes(_:) — incremental updates over the internal observable vector; realized items, selection and scroll position are preserved. Positions are expressed by index, identity by id (ids must be unique)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "appendIds(_:) / insertIds(_:at:) / removeIds(_:) / removeIndexes(_:) — incremental updates over the internal observable vector; realized items, selection and scroll position are preserved. Positions are expressed by index, identity by id (ids must be unique)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "appendIds(_:) / insertIds(_:at:) / removeIds(_:) / removeIndexes(_:) —— 基于内部可观察向量的增量更新，已实现条目、选择与滚动位置均保留。位置以索引表达、身份以 id 表达（id 需唯一）。"
          }
        }
      }
    },
    "selectedIds — id-based selection readout built on selectedIndexes + string(at:), the same reading primitive as ids (ItemsView exposes no native selection set; its selectionChanged args are an empty shell)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selectedIds — id-based selection readout built on selectedIndexes + string(at:), the same reading primitive as ids (ItemsView exposes no native selection set; its selectionChanged args are an empty shell)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selectedIds —— 基于 selectedIndexes + string(at:) 的 id 维度选择读取，与 ids 同一读取原语（ItemsView 无原生选中集入口，selectionChanged 事件参数是空壳）。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}
