        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纯代码构造的 itemTemplate"
          }
        }
      }
    },
    "DataTemplate content cannot be defined in pure code (WinUI has no FrameworkElementFactory), but ItemsView.itemTemplate actually accepts any IElementFactory." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DataTemplate content cannot be defined in pure code (WinUI has no FrameworkElementFactory), but ItemsView.itemTemplate actually accepts any IElementFactory."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DataTemplate 的内容无法纯代码定义（WinUI 没有 FrameworkElementFactory），但 ItemsView.itemTemplate 实际接受任意 IElementFactory 实现。"
          }
        }
      }
    },
    "The projection lets Swift types implement WinRT interfaces: ItemContainerFactory returns a new ItemContainer() per getElement and no-ops recycleElement, replacing the former XAML string template." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The projection lets Swift types implement WinRT interfaces: ItemContainerFactory returns a new ItemContainer() per getElement and no-ops recycleElement, replacing the former XAML string template."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投影允许 Swift 类型实现 WinRT 接口：ItemContainerFactory 每次 getElement 返回新的 ItemContainer()、recycleElement 空实现，取代了原先的 XAML 字符串模板。"
          }
        }
      }
    },
    "The control no longer depends on XamlReader or App.context; verified at runtime via UI Automation — items render and selection reads back correctly." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The control no longer depends on XamlReader or App.context; verified at runtime via UI Automation — items render and selection reads back correctly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控件不再依赖 XamlReader 与 App.context；已经 UI Automation 运行期验证——条目正常渲染、选择可正确读回。"
          }
        }
      }
    },
