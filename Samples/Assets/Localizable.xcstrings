    "context.open([URL]) opens many tabs in one render instead of looping over open(_:mode:)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "context.open([URL]) opens many tabs in one render instead of looping over open(_:mode:)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "context.open([URL]) 一次渲染即可打开多个标签页，无需循环调用 open(_:mode:)。"
          }
        }
      }
    },
    "context.open(routes) — opens every route as a tab and selects the last one." : {
      "extractionState" : "manual",
      "localizations" : {
