    },
    "A dual-thumb slider for picking a range. Drag a thumb, click the track, or use the keyboard (←/→ adjust, ↑/↓ switch the active thumb, Home/End jump to bounds)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dual-thumb slider for picking a range. Drag a thumb, click the track, or use the keyboard (←/→ adjust, ↑/↓ switch the active thumb, Home/End jump to bounds)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双滑块范围选择控件：可拖动滑块、点击轨道跳转，或使用键盘（←/→ 调整，↑/↓ 切换当前滑块，Home/End 跳到边界）。"
          }
        }
      }
    },
    "Basic usage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basic usage"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
