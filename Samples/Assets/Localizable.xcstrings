{
  "sourceLanguage" : "en",
  "strings" : {
    ".inplace, .newTab, .newTabBackground, .newWindow." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".inplace, .newTab, .newTabBackground, .newWindow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".inplace、.newTab、.newTabBackground、.newWindow。"
          }
        }
      }
    },
    "A dual-thumb slider for picking a range. Drag a thumb, click the track, or drag between the thumbs to slide both together (width kept). Tab to a thumb for keyboard: ←/→ adjust, PageUp/PageDown larger steps, Home/End to the bounds." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dual-thumb slider for picking a range. Drag a thumb, click the track, or drag between the thumbs to slide both together (width kept). Tab to a thumb for keyboard: ←/→ adjust, PageUp/PageDown larger steps, Home/End to the bounds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双滑块范围选择控件：可拖动滑块、点击轨道跳转，或拖动两滑块之间的选区整体平移（保持窗宽）。Tab 聚焦滑块后可用键盘：←/→ 调整，PageUp/PageDown 大步进，Home/End 到边界。"
          }
        }
      }
    },
    "A GridView composed over ItemsView. Ctrl/Shift-click to multi-select, then double-click any selected tile: the selection is kept and itemDoubleTapped reports the whole set. Enable check box selection to toggle items with hover check boxes like File Explorer." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GridView composed over ItemsView. Ctrl/Shift-click to multi-select, then double-click any selected tile: the selection is kept and itemDoubleTapped reports the whole set. Enable check box selection to toggle items with hover check boxes like File Explorer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 ItemsView 组合的网格视图。用 Ctrl/Shift 点击进行多选后，双击其中任意一项：选择保持不变，并通过 itemDoubleTapped 事件携带完整的选择集合。开启复选框选择后，可用资源管理器式的悬停复选框逐项勾选。"
          }
        }
      }
    },
    "A RadioButtons-like single-select group built from AppBarToggleButtons laid out by a VariableSizedWrapGrid. Only one item stays checked; tapping the checked item does not uncheck it. Items are identified by their tag string." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A RadioButtons-like single-select group built from AppBarToggleButtons laid out by a VariableSizedWrapGrid. Only one item stays checked; tapping the checked item does not uncheck it. Items are identified by their tag string."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 AppBarToggleButton 组成、VariableSizedWrapGrid 自动布局的单选按钮组，行为类似 RadioButtons：同一时刻仅一项选中，点击已选中项不会反选。项目以 tag 字符串标识。"
          }
        }
      }
    },
    "All items" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All items"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部项目"
          }
        }
      }
    },
    "App-level new window entry — used when there is no WindowContext at hand. The forceMinimalMode flag enables a viewer-style window that does not pollute the main window's NavPane preference." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-level new window entry — used when there is no WindowContext at hand. The forceMinimalMode flag enables a viewer-style window that does not pollute the main window's NavPane preference."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用级新建窗口入口——手头没有 WindowContext 时使用。forceMinimalMode 标志可创建查看器式窗口，且不会污染主窗口的导航窗格偏好。"
          }
        }
      }
    },
    "App.context.openNewWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.openNewWindow"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.openNewWindow"
          }
        }
      }
    },
    "App.context.openNewWindow(forceMinimalMode: true)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.openNewWindow(forceMinimalMode: true)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.openNewWindow(forceMinimalMode: true)"
          }
        }
      }
    },
    "App.context.theme and App.context.language are @Observable. Setting them rebuilds the chrome of every open window and persists to preferences." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.theme and App.context.language are @Observable. Setting them rebuilds the chrome of every open window and persists to preferences."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App.context.theme 与 App.context.language 均为 @Observable。修改后会重建所有已打开窗口的框架，并持久化到偏好设置。"
          }
        }
      }
    },
