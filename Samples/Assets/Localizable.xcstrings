          "stringUnit" : {
            "state" : "translated",
            "value" : "context.open(routes)——把每条路由各开为一个标签页，并选中最后一个。"
          }
        }
      }
    },
    "context.open(routes, mode: .newTabBackground) — opens the same tabs without leaving this page." : {
